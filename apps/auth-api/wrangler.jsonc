{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codebot-auth-api",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker-entry.ts",
  "workers_dev": false,
  "preview_urls": false,
  "cache": {
    "enabled": true,
    "cross_version_cache": false
  },
  "observability": {
    "enabled": false
  },
  "upload_source_maps": false,
  "triggers": {
    "crons": ["*/5 * * * *", "*/1 * * * *"]
  },
  "routes": [
    {
      "pattern": "codebot.example/*",
      "zone_id": "bac5e044ba951c390229f0e93673ebd3"
    },
    {
      "pattern": "www.codebot.example/*",
      "zone_id": "bac5e044ba951c390229f0e93673ebd3"
    },
    {
      "pattern": "api.codebot.example",
      "custom_domain": true
    },
    {
      "pattern": "nearintents.codebot.example",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": [
      "EMAIL_SMTP_PASSWORD",
      "SKILLS_ADMIN_TOKEN",
      "SITE_REPORT_HASH_SECRET",
      "REMOTE_TICKET_PRIVATE_JWK",
      "REMOTE_TICKET_PUBLIC_JWKS",
      "REMOTE_AUTH_WEBHOOK_SECRET"
    ]
  },
  "vars": {
    "AUTH_EXPOSE_DEVELOPMENT_CODE": "false",
    "BROWSER_EXTENSION_IDS": "eggdpikcggoicfcfdpdihfkinajchpfj",
    "EMAIL_SMTP_HOST": "mail.privateemail.com",
    "EMAIL_SMTP_PORT": "465",
    "EMAIL_SMTP_USERNAME": "no_reply@codebot.example",
    "EMAIL_FROM": "no_reply@codebot.example",
    "EMAIL_REPLY_TO": "hello@codebot.example",
    "EMAIL_LICENSE_REPLY_TO": "licenses@codebot.example",
    "EMAIL_LICENSE_FROM": "",
    "REMOTE_TICKET_KEY_ID": "codebot-remote-1",
    "REMOTE_SIGNAL_URL": "wss://signal.codebot.example/v1/signal",
    "REMOTE_SIGNAL_HOMES": "a=wss://signal1.codebot.example/v1/signal,b=wss://signal2.codebot.example/v1/signal,us=wss://signal-us.codebot.example/v1/signal,au=wss://signal-au.codebot.example/v1/signal,sg=wss://signal-sg.codebot.example/v1/signal",
    "REMOTE_SIGNAL_HOME_LOCATIONS": "a=60.17:24.94,b=60.17:24.94,us=37.34:-121.89,au=-33.87:151.21,sg=1.35:103.82",
    "REMOTE_SIGNAL_HOME_COUNTRIES": "CN=us",
    "REMOTE_AUTH_WEBHOOK_URL": "https://signal.codebot.example/internal/auth-events",
    "REMOTE_AUTH_WEBHOOK_URLS": "https://signal1.codebot.example/internal/auth-events,https://signal2.codebot.example/internal/auth-events,https://signal-us.codebot.example/internal/auth-events,https://signal-au.codebot.example/internal/auth-events,https://signal-sg.codebot.example/internal/auth-events",
    "SIGNAL_ENTRY_ZONE_ID": "bac5e044ba951c390229f0e93673ebd3",
    "HOSTED_SERVERS_ENABLED": "true",
    "HOSTED_SERVERS_ALLOWED_USER_IDS": "*",
    "LICENSE_TRIAL_END": "2026-12-01T00:00:00Z",
    "BILLING_COUNTRY_REQUIRED": "true",
    "GITHUB_APP_CLIENT_ID": "Iv23lik5pzHz70cb0RUL",
    "FEEDBACK_WITHDRAWN_REPOSITORY": "",
    "APNS_TEAM_ID": "8A47NKRZSJ",
    "APNS_TOPIC": "run.codebot.mobile"
  },
  "services": [
    {
      "binding": "EMAIL_RELAY",
      "service": "codebot-email-relay"
    },
    {
      "binding": "MEDIA_GATEWAY",
      "service": "codebot-media-gateway"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL_FALLBACK",
      "allowed_sender_addresses": ["no_reply@codebot.example"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codebot-auth",
      "database_id": "0cf7e5c1-63ad-4089-810a-e9eb67dd863d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "codebot-avatars",
      "preview_bucket_name": "codebot-avatars-test"
    },
    {
      "binding": "SKILLS",
      "bucket_name": "codebot-skills",
      "preview_bucket_name": "codebot-skills-test"
    },
    {
      "binding": "SITES",
      "bucket_name": "codebot-sites",
      "preview_bucket_name": "codebot-sites-test"
    }
  ],
  "ratelimits": [
    {
      "name": "MARKETPLACE_INGRESS_RATE_LIMITER",
      "namespace_id": "2026082701",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "MARKETPLACE_MUTATION_RATE_LIMITER",
      "namespace_id": "2026082702",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "MARKETPLACE_UPLOAD_RATE_LIMITER",
      "namespace_id": "2026082703",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "SITE_REPORT_RATE_LIMITER",
      "namespace_id": "2026083101",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "GITHUB_TOKEN_RATE_LIMITER",
      "namespace_id": "2026092911",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "LIVE_ACTIVITY_RATE_LIMITER",
      "namespace_id": "2026092901",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "2026110801",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "env": {
    "preview": {
      "name": "codebot-landing-preview",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "triggers": {
        "crons": []
      },
      "secrets": {
        "required": []
      },
      "vars": {
        "AUTH_EXPOSE_DEVELOPMENT_CODE": "false",
        "EMAIL_SMTP_HOST": "mail.privateemail.com",
        "EMAIL_SMTP_PORT": "465",
        "EMAIL_SMTP_USERNAME": "no_reply@codebot.example",
        "EMAIL_FROM": "no_reply@codebot.example",
        "EMAIL_REPLY_TO": "hello@codebot.example",
        "EMAIL_LICENSE_REPLY_TO": "licenses@codebot.example",
        "EMAIL_LICENSE_FROM": "",
        "SITE_PUBLISH_ENABLED": "false",
        "SITE_COOKIE_ISOLATION_READY": "false",
        "REMOTE_TICKET_KEY_ID": "codebot-remote-1",
        "REMOTE_SIGNAL_URL": "ws://127.0.0.1:8081/v1/signal",
        "REMOTE_SIGNAL_HOMES": "",
        "REMOTE_AUTH_WEBHOOK_URL": "http://127.0.0.1:8081/internal/auth-events",
        "REMOTE_AUTH_WEBHOOK_URLS": "",
        "SIGNAL_ENTRY_ZONE_ID": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "codebot-auth-test",
