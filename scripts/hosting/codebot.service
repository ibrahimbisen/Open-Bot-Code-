[Unit]
Description=CodeBot hosted server
Wants=network-online.target codebot-update-apply.service
After=network-online.target display-manager.service
ConditionPathExists=!/run/codebot-pre-stop

[Service]
Type=simple
User=@SERVICE_USER@
RuntimeDirectory=codebot
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/codebot
ExecStartPre=-+/opt/CodeBot/hosted/codebot-hosted-update trigger
ExecStart=/opt/CodeBot/hosted/codebot-hosted-server
ExecStop=/opt/CodeBot/hosted/codebot-hosted-server --stop
Restart=always
RestartSec=10
RestartPreventExitStatus=78
TimeoutStopSec=60
MemoryMax=90%
OOMScoreAdjust=-500
OOMPolicy=continue

[Install]
WantedBy=multi-user.target lightdm.service
