#!/bin/bash
# codebot-boat-pre-stop: installed by codebot-hosted-update. Changes to this file are replaced.
set -u

sudo -n touch /run/codebot-pre-stop || exit 1
sudo -n systemctl stop codebot-pre-stop-restart.timer 2>/dev/null
sudo -n systemd-run --quiet --collect --unit=codebot-pre-stop-restart --on-active=15min /bin/sh -c \
  'if find /run/codebot-pre-stop -mmin +5 2>/dev/null | grep -q .; then rm -f /run/codebot-pre-stop && systemctl start --no-block codebot.service; fi' ||
  echo "The start after a cancelled stop is not set." >&2
if sudo -n timeout 40 systemctl stop codebot.service; then exit 0; fi
sudo -n systemctl kill --signal=SIGKILL codebot.service
for _ in $(seq 1 10); do
  case $(systemctl show --property=ActiveState --value codebot.service) in
    inactive | failed) exit 0 ;;
  esac
  sleep 0.5
done
exit 1
