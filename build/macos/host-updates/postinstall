#!/bin/sh
set -eu
export PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C
ROOT='/Library/Application Support/CodeBot/HostManager'
"$ROOT/codebot-host" --verify-installation
if [ -f "$ROOT/config.json" ] && [ ! -L "$ROOT/config.json" ]; then
  launchctl bootstrap system /Library/LaunchDaemons/app.codebot.host-manager.plist
fi
echo 'CodeBot Host installed. Run sudo codebot-host setup, then sudo codebot-host verify.'
